---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Check from '@/components/Check.astro';
import Icon from '@/components/Icon.astro';
import Cta from '@/components/Cta.astro';
import { site } from '@/data/site';
import { services, usp } from '@/data/services';

/**
 * Treść oparta wyłącznie na zweryfikowanych źródłach: profil Fixly
 * (opis, staż, oceny, obszar) i wizytówka Panorama Firm (dane rejestrowe).
 * ⚠️ Brakuje historii właścicielki i zdjęcia — to jedyne, czego nie da się
 * napisać za klienta, a co najmocniej odróżniłoby firmę od konkurencji.
 */
---

<BaseLayout
  title="O nas"
  description="Czyste Sprawy — firma sprzątająca z Poznania prowadzona przez Yuliię Dubetską. Ubezpieczenie OC, dane zweryfikowane w GUS."
  path="/o-nas"
>
  <section class="border-b border-ivory-line">
    <div class="mx-auto grid max-w-5xl gap-12 px-5 py-16 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <div>
        <p class="eyebrow hairline">O nas</p>
        <h1 class="display-lg mt-6 font-display text-forest">
          Mała firma,<br />
          <span class="italic text-forest-soft">konkretna odpowiedzialność</span>
        </h1>
        <p class="mt-8 text-lg leading-relaxed text-ink-soft">
          Czyste Sprawy to firma sprzątająca z Poznania, prowadzona przez
          <strong class="text-ink">{site.owner}</strong>. Oferujemy sprzątanie mieszkań,
          domów i biur, sprzątanie po remoncie i po wynajmie krótkoterminowym oraz mycie
          okien. Pracujemy szybko i dokładnie, z indywidualnym podejściem do każdego
          zlecenia.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Za efekt odpowiada konkretna osoba, a nie infolinia — i to jest cała różnica
          między nami a dużym operatorem.
        </p>
      </div>
      <img
        src="/brand/team-photo.webp"
        alt="Yuliia Dubetska, właścicielka Czyste Sprawy, w firmowym fartuchu z logo CS"
        width="752"
        height="629"
        class="w-full rounded border border-ivory-line"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- Fakty -->
  <section class="bg-ivory-warm py-16">
    <div class="mx-auto max-w-3xl px-5">
      <SectionHeading eyebrow="Fakty" title="Co da się sprawdzić" />
      <dl class="mt-10 grid gap-x-10 gap-y-6 sm:grid-cols-2">
        <div class="rule pt-5">
          <dt class="text-sm text-ink-mute">Doświadczenie</dt>
          <dd class="font-display text-2xl text-forest">
            {site.proof.yearsExperience} lata na rynku
          </dd>
        </div>
        <div class="rule pt-5">
          <dt class="text-sm text-ink-mute">Ubezpieczenie</dt>
          <dd class="font-display text-2xl text-forest">OC {site.insurance.amount}</dd>
        </div>
        <div class="rule pt-5">
          <dt class="text-sm text-ink-mute">Dane firmy</dt>
          <dd class="font-display text-2xl text-forest">Zweryfikowane w GUS</dd>
        </div>
        <div class="rule pt-5">
          <dt class="text-sm text-ink-mute">NIP</dt>
          <dd class="font-display text-2xl text-forest">{site.nip}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- USP -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <SectionHeading eyebrow="Jak pracujemy" title="Osiem powodów, żeby zaufać" align="center" />
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        usp.map((u) => (
          <div class="card-sage flex flex-col items-center gap-3 p-6 text-center">
            <Icon name={u.icon} class="h-7 w-7" />
            <p class="font-semibold leading-snug">{u.title}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Zakres i obszar -->
  <section class="bg-ivory-warm py-16">
    <div class="mx-auto grid max-w-3xl gap-10 px-5 sm:grid-cols-2">
      <div>
        <h2 class="font-display text-xl text-forest">Co robimy</h2>
        <ul class="mt-4 space-y-2.5">
          {
            services.map((s) => (
              <li class="flex items-start gap-2.5">
                <Check class="mt-1.5 !h-4 !w-4" />
                <a href={`/uslugi/${s.slug}`} class="text-ink-soft hover:text-forest">
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-display text-xl text-forest">Gdzie pracujemy</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          {site.areaServed.join(' · ')}
        </p>
        <p class="mt-4 text-sm text-ink-mute">
          Przy dalszych lokalizacjach potwierdzamy dojazd przy wycenie.
        </p>
      </div>
    </div>
  </section>

  <div class="py-20"><Cta /></div>
</BaseLayout>
