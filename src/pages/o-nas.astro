---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import Cta from '@/components/Cta.astro';
import { site } from '@/data/site';
import { services, usp } from '@/data/services';

/**
 * Treść oparta wyłącznie na zweryfikowanych źródłach: profil Fixly
 * (opis, staż, obszar) i wizytówka Panorama Firm (dane rejestrowe).
 *
 * "Dlaczego my" i "Jak pracujemy" przeniesione tu ze strony głównej —
 * to strona, na której czytelnik już zdecydował się poznać firmę bliżej.
 * Sekcja "Fakty" (staż / NIP / GUS w tabelce) usunięta — te informacje
 * i tak są w tekście wstępu i w stopce, tabelka tylko duplikowała je sucho.
 */
---

<BaseLayout
  title="O nas"
  description="Czyste Sprawy — firma sprzątająca z Poznania prowadzona przez Yuliię Dubetską. Ubezpieczenie OC, dane zweryfikowane w GUS."
  path="/o-nas"
>
  <section class="border-b border-ivory-line">
    <div class="mx-auto grid max-w-5xl gap-12 px-5 py-16 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <div>
        <p class="eyebrow hairline">O nas</p>
        <h1 class="display-lg mt-6 font-display text-forest">
          Mała firma,<br />
          <span class="italic text-forest-soft">konkretna odpowiedzialność</span>
        </h1>
        <p class="mt-8 text-lg leading-relaxed text-ink-soft">
          Czyste Sprawy to firma sprzątająca z Poznania, prowadzona przez
          <strong class="text-ink">{site.owner}</strong>. Oferujemy sprzątanie mieszkań,
          domów i biur, sprzątanie po remoncie i po wynajmie krótkoterminowym oraz mycie
          okien. Pracujemy szybko i dokładnie, z indywidualnym podejściem do każdego
          zlecenia.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-ink-soft">
          Za efekt odpowiada konkretna osoba, a nie infolinia — i to jest cała różnica
          między nami a dużym operatorem. Działamy {site.proof.yearsExperience} lata,
          z ubezpieczeniem OC do {site.insurance.amount}, a dane firmy (NIP {site.nip})
          są zweryfikowane w rejestrze GUS.
        </p>
      </div>
      <img
        src="/brand/team-photo.webp"
        alt="Yuliia Dubetska, właścicielka Czyste Sprawy, w firmowym fartuchu z logo CS"
        width="752"
        height="629"
        class="w-full rounded border border-ivory-line"
        loading="eager"
        decoding="async"
      />
    </div>
  </section>

  <!-- Dlaczego my -->
  <section class="bg-ivory-warm py-20">
    <div class="mx-auto max-w-6xl px-5">
      <SectionHeading eyebrow="Dlaczego my" title="Osiem powodów, żeby zaufać" align="center" />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          usp.map((u) => (
            <div class="card-sage flex flex-col items-center gap-3 p-6 text-center">
              <Icon name={u.icon} class="h-7 w-7" />
              <p class="font-semibold leading-snug">{u.title}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Jak pracujemy -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading eyebrow="Jak pracujemy" title="Cztery kroki, zero niejasności" />
    <ol class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          {
            title: 'Zgłoszenie',
            body: 'Piszesz, co trzeba posprzątać: rodzaj usługi, metraż, preferowany termin.',
          },
          {
            title: 'Bezpłatna wycena',
            body: 'Na podstawie opisu i kilku zdjęć podajemy konkretną cenę — jeszcze przed rozpoczęciem pracy.',
          },
          {
            title: 'Sprzątanie',
            body: 'Przyjeżdżamy z własnym sprzętem i środkami, w ustalonym terminie.',
          },
          {
            title: 'Odbiór',
            body: 'Sprawdzamy efekt przed wyjściem. Jeśli coś wymaga poprawy — poprawiamy od razu.',
          },
        ].map((s, i) => (
          <li class="rule pt-6">
            <span class="font-display text-sm text-sand">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-display text-xl text-forest">{s.title}</h3>
            <p class="mt-2.5 leading-relaxed text-ink-soft">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Co robimy / Gdzie pracujemy -->
  <section class="bg-ivory-warm py-20">
    <div class="mx-auto grid max-w-5xl gap-14 px-5 lg:grid-cols-[1.2fr_0.8fr]">
      <div>
        <h2 class="font-display text-2xl text-forest">Co robimy</h2>
        <ul class="mt-6">
          {
            services.map((s, i) => (
              <li class="rule">
                <a
                  href={`/uslugi/${s.slug}`}
                  class="group flex items-center gap-4 py-4 transition-colors"
                >
                  <span class="font-display text-sm text-sand">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="flex-1 font-display text-lg text-forest transition-colors group-hover:text-forest-soft">
                    {s.name}
                  </span>
                  <span class="shrink-0 text-forest opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">
                    →
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-display text-2xl text-forest">Gdzie pracujemy</h2>
        <p class="mt-4 leading-relaxed text-ink-soft">
          {site.areaServed.join(' · ')}
        </p>
        <p class="mt-4 text-sm text-ink-mute">
          Przy dalszych lokalizacjach potwierdzamy dojazd przy wycenie.
        </p>
      </div>
    </div>
  </section>

  <div class="py-20"><Cta /></div>
</BaseLayout>
