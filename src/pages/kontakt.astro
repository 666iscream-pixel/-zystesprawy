---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { site, waLink, waDefaultMessage } from '@/data/site';
---

<BaseLayout
  title="Kontakt"
  description="Skontaktuj się z Czyste Sprawy — sprzątanie mieszkań, domów i biur w Poznaniu i okolicach. Telefon, WhatsApp, e-mail."
  path="/kontakt"
>
  <section class="mx-auto max-w-6xl px-5 py-16">
    <SectionHeading
      eyebrow="Kontakt"
      title="Napisz albo zadzwoń"
      lead="Najszybciej odpowiadamy na WhatsApp. Jeśli chcesz od razu poznać cenę — wypełnij krótki formularz wyceny."
    />

    <div class="mt-12 grid gap-8 lg:grid-cols-[1.1fr_1fr]">
      <div class="space-y-5">
        <a
          href={`tel:${site.phone}`}
          class="card flex items-center justify-between gap-5 p-7 transition-colors hover:border-forest/40"
        >
          <span>
            <span class="eyebrow">Telefon</span>
            <span class="mt-2 block font-display text-2xl text-forest">
              {site.phoneDisplay}
            </span>
            <span class="mt-1 block text-sm text-ink-mute">{site.hours}</span>
          </span>
          <span class="text-sand" aria-hidden="true">→</span>
        </a>

        <a
          href={waLink(waDefaultMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="card flex items-center justify-between gap-5 p-7 transition-colors hover:border-forest/40"
        >
          <span>
            <span class="eyebrow">WhatsApp</span>
            <span class="mt-2 block font-display text-2xl text-forest">Napisz wiadomość</span>
            <span class="mt-1 block text-sm text-ink-mute">
              Zdjęcia przyspieszają wycenę
            </span>
          </span>
          <span class="text-sand" aria-hidden="true">→</span>
        </a>

        <a
          href={`mailto:${site.email}`}
          class="card flex items-center justify-between gap-5 p-7 transition-colors hover:border-forest/40"
        >
          <span>
            <span class="eyebrow">E-mail</span>
            <span class="mt-2 block font-display text-2xl text-forest">{site.email}</span>
          </span>
          <span class="text-sand" aria-hidden="true">→</span>
        </a>

        <a
          href="/wycena"
          class="flex items-center justify-between gap-5 rounded bg-forest p-7 text-ivory transition-colors hover:bg-forest-deep"
        >
          <span>
            <span class="eyebrow !text-ivory/60">Najszybsza droga</span>
            <span class="mt-2 block font-display text-2xl">Formularz wyceny</span>
            <span class="mt-1 block text-sm text-ivory/70">
              Kilka pól, gotowe zapytanie
            </span>
          </span>
          <span class="text-sand" aria-hidden="true">→</span>
        </a>
      </div>

      <aside class="space-y-5">
        <div class="card p-7 text-sm">
          <h2 class="font-display text-xl text-forest">Dane firmy</h2>
          <address class="mt-4 not-italic leading-relaxed text-ink-soft">
            {site.legalName}<br />
            {site.address.street}<br />
            {site.address.postalCode} {site.address.city}, {site.address.district}<br />
            woj. {site.address.region}
          </address>
          <dl class="mt-4 space-y-1 text-ink-soft">
            <div class="flex gap-2"><dt>NIP:</dt><dd>{site.nip}</dd></div>
          </dl>
          <p class="mt-4 text-ink-mute">Dane zweryfikowane w rejestrze GUS.</p>
        </div>

        <div class="card p-7 text-sm">
          <h2 class="font-display text-xl text-forest">Obszar działania</h2>
          <p class="mt-3 leading-relaxed text-ink-soft">{site.areaServed.join(' · ')}</p>
          <p class="mt-3 text-ink-mute">
            Przy dalszych lokalizacjach potwierdzamy dojazd przy wycenie.
          </p>
        </div>

        <div class="card p-7 text-sm">
          <h2 class="font-display text-xl text-forest">Znajdź nas</h2>
          <ul class="mt-3 space-y-2">
            <li>
              <a
                href={site.fixly}
                target="_blank"
                rel="noopener noreferrer"
                class="text-forest underline underline-offset-4"
              >
                Profil na Fixly
              </a>
            </li>
            <li>
              <a
                href={site.panoramaFirm}
                target="_blank"
                rel="noopener noreferrer"
                class="text-forest underline underline-offset-4"
              >
                Wizytówka w Panorama Firm
              </a>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
