---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Check from '@/components/Check.astro';
import Icon from '@/components/Icon.astro';
import Cross from '@/components/Cross.astro';
import Cta from '@/components/Cta.astro';
import { services, alwaysIncluded, exclusions } from '@/data/services';
import { waLink } from '@/data/site';
import { priceMatrix, windowPrice, formatRange } from '@/data/pricing';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);

const roomPriced = priceMatrix[service.slug];
const isOffice = service.slug === 'sprzatanie-biur';
const isWindows = service.slug === 'mycie-okien';
---

<BaseLayout
  title={`${service.name} — Poznań`}
  description={`${service.lead} Czyste Sprawy — Poznań i okolice. Bezpłatna wycena przed rozpoczęciem pracy.`}
  path={`/uslugi/${service.slug}`}
>
  <article>
    <header class="border-b border-ivory-line">
      <div class="mx-auto max-w-4xl px-5 py-16">
        <nav aria-label="Okruszki" class="mb-6 text-sm text-ink-mute">
          <a href="/" class="hover:text-forest">Start</a>
          <span class="mx-2">/</span>
          <a href="/uslugi" class="hover:text-forest">Usługi</a>
        </nav>

        <h1 class="display-lg font-display text-forest">{service.name}</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft">{service.lead}</p>

        {
          roomPriced && (
            <p class="mt-5 font-display text-2xl text-forest">
              od {roomPriced['1']!.from} zł
              <span class="ml-2 text-sm font-sans font-normal text-ink-mute">
                orientacyjnie, za mieszkanie 1-pokojowe
              </span>
            </p>
          )
        }
        {
          isWindows && (
            <p class="mt-5 font-display text-2xl text-forest">
              {formatRange(windowPrice)}
              <span class="ml-2 text-sm font-sans font-normal text-ink-mute">za okno, orientacyjnie</span>
            </p>
          )
        }

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href={isOffice ? '/dla-firm' : '/wycena'} class="btn btn-primary">
            {isOffice ? 'Umów bezpłatną wizytę' : 'Bezpłatna wycena'}
          </a>
          {
            !isOffice && (
              <a href="/kalkulator" class="btn btn-ghost">
                Sprawdź w kalkulatorze
              </a>
            )
          }
          <a
            href={waLink(
              `Dzień dobry! Piszę ze strony czystesprawy.pl — interesuje mnie: ${service.name}.`
            )}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost">Zapytaj na WhatsApp</a
          >
        </div>
      </div>
    </header>

    <!-- Zakres -->
    <section class="mx-auto max-w-4xl px-5 py-16">
      <SectionHeading eyebrow="Zakres" title="Co obejmuje usługa" />
      <div class="mt-12 space-y-12">
        {
          service.groups.map((g) => (
            <div>
              <h3 class="font-display text-xl text-forest">{g.title}</h3>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {g.items.map((item) => (
                  <li class="flex items-start gap-3 leading-relaxed text-ink-soft">
                    <Check class="mt-1.5" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>

      <div class="mt-12 rounded border border-ivory-line bg-ivory-warm p-7">
        <h3 class="font-display text-lg text-forest">W każdej usłudze wliczone</h3>
        <ul class="mt-4 flex flex-wrap gap-x-7 gap-y-2 text-sm text-ink-soft">
          {
            alwaysIncluded.map((i) => (
              <li class="flex items-center gap-2">
                <Check class="!h-4 !w-4" />
                {i}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Dla kogo -->
    <section class="bg-ivory-warm py-14">
      <div class="mx-auto max-w-4xl px-5">
        <h2 class="font-display text-2xl text-forest">Dla kogo</h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-soft">{service.forWhom}</p>
      </div>
    </section>

    <!-- Warto wiedzieć -->
    <section class="mx-auto max-w-4xl px-5 py-16">
      <h2 class="font-display text-2xl text-forest">Warto wiedzieć</h2>
      <p class="mt-3 text-ink-soft">
        Mówimy wprost, gdzie są granice usługi — żeby nie było rozczarowań.
      </p>
      <ul class="mt-6 space-y-4">
        {
          service.notes.map((n) => (
            <li class="flex items-start gap-4 leading-relaxed text-ink-soft">
              <span class="mt-2.5 h-1 w-4 shrink-0 bg-sand" aria-hidden="true" />
              {n}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 rounded border border-ivory-line bg-white p-7">
        <h3 class="font-display text-lg text-forest">Czego nie robimy</h3>
        <ul class="mt-4 grid gap-2.5 sm:grid-cols-2">
          {
            exclusions.map((e) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-soft">
                <Cross class="mt-0.5" />
                {e}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mt-10 rounded border border-ivory-line bg-white p-7">
        <h3 class="font-display text-lg text-forest">Ile to kosztuje?</h3>
        <p class="mt-3 leading-relaxed text-ink-soft">
          {isOffice
            ? 'Cenę ustalamy po bezpłatnej wizycie w obiekcie — zależy od metrażu, częstotliwości i zakresu.'
            : 'Nie publikujemy sztywnego cennika, bo dwa podobne metrażem lokale potrafią wymagać zupełnie różnej ilości pracy.'}
          {!isOffice && (
            <>
              {' '}Zamiast tego wyceniamy konkretnie: opisz zakres, dorzuć kilka zdjęć — odeślemy
              cenę <strong class="text-ink">przed rozpoczęciem pracy</strong>.
            </>
          )}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={isOffice ? '/dla-firm' : '/wycena'} class="btn btn-primary">
            {isOffice ? 'Umów bezpłatną wizytę' : 'Poproś o wycenę'}
          </a>
          {!isOffice && (
            <a href="/kalkulator" class="btn btn-ghost">Kalkulator orientacyjny</a>
          )}
        </div>
      </div>
    </section>

    <!-- Pozostałe usługi -->
    <section class="mx-auto max-w-4xl px-5 pb-16">
      <h2 class="font-display text-2xl text-forest">Pozostałe usługi</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {
          others.map((s) => (
            <a
              href={`/uslugi/${s.slug}`}
              class="card flex items-center justify-between gap-4 p-5 transition-colors hover:border-forest/40"
            >
              <span class="font-display text-lg text-forest">{s.name}</span>
              <span class="shrink-0 text-sand" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </section>

    <div class="pb-24"><Cta /></div>
  </article>
</BaseLayout>
