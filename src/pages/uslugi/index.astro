---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import Cross from '@/components/Cross.astro';
import Cta from '@/components/Cta.astro';
import { services, exclusions } from '@/data/services';
---

<BaseLayout
  title="Usługi sprzątania — Poznań"
  description="Sprzątanie mieszkań i domów, po remoncie, po wynajmie, mycie okien, sprzątanie biur. Pięć jasno opisanych usług. Poznań i okolice, bezpłatna wycena."
  path="/uslugi"
>
  <section class="mx-auto max-w-6xl px-5 pb-14 pt-16">
    <SectionHeading
      eyebrow="Usługi"
      title="Pięć rzeczy, które robimy"
      lead="Każda usługa ma osobną stronę z pełnym zakresem. Wybierz tę, która pasuje do Twojej sytuacji."
    />
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={`/uslugi/${s.slug}`}
            class="group flex flex-col rounded border border-ivory-line bg-white p-7 transition-colors hover:border-forest"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-sage text-forest">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <h2 class="mt-5 font-display text-xl text-forest">{s.name}</h2>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-soft">{s.lead}</p>
            <span class="mt-5 inline-flex items-center gap-2 border-b border-forest/30 pb-0.5 text-sm text-forest transition-colors group-hover:border-forest">
              Zobacz zakres i cenę →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Czego nie robimy -->
  <section class="bg-ivory-warm py-16">
    <div class="mx-auto max-w-4xl px-5">
      <SectionHeading eyebrow="Warto wiedzieć" title="Czego nie robimy" />
      <p class="mt-4 max-w-2xl text-ink-soft">
        Mówimy o tym wprost, żeby nie było niedomówień przy pierwszej wizycie.
      </p>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2">
        {
          exclusions.map((e) => (
            <li class="flex items-start gap-3 rounded border border-ivory-line bg-white px-4 py-3 text-sm text-ink-soft">
              <Cross class="mt-0.5" />
              {e}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="py-20"><Cta /></div>
</BaseLayout>
