---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Check from '@/components/Check.astro';
import Cta from '@/components/Cta.astro';
import { services } from '@/data/services';
---

<BaseLayout
  title="Usługi sprzątania — Poznań"
  description="Sprzątanie mieszkań i domów, mycie okien, sprzątanie biur. Pełny zakres każdej usługi. Poznań i okolice, bezpłatna wycena."
  path="/uslugi"
>
  <section class="mx-auto max-w-6xl px-5 pb-14 pt-16">
    <SectionHeading
      eyebrow="Usługi"
      title="Co dokładnie robimy"
      lead="Każda usługa ma spisany zakres — i wypisane granice. Dzięki temu wiadomo, czego się spodziewać, zanim zaczniemy."
    />
  </section>

  {
    services.map((s, i) => (
      <section class:list={['py-16', i % 2 === 1 && 'bg-ivory-warm']}>
        <div class="mx-auto max-w-6xl px-5">
          <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="lg:sticky lg:top-32 lg:self-start">
              <span class="font-display text-sm text-sand">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h2 class="display-md mt-3 font-display text-forest">{s.name}</h2>
              <p class="mt-4 leading-relaxed text-ink-soft">{s.lead}</p>
              <a href={`/uslugi/${s.slug}`} class="btn btn-ghost mt-7">
                Szczegóły usługi
              </a>
            </div>

            <div class="grid gap-8 sm:grid-cols-2">
              {s.groups.map((g) => (
                <div>
                  <h3 class="font-display text-lg text-forest">{g.title}</h3>
                  <ul class="mt-4 space-y-2.5">
                    {g.items.map((item) => (
                      <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-soft">
                        <Check class="mt-1 !h-4 !w-4" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <div class="py-24"><Cta /></div>
</BaseLayout>
