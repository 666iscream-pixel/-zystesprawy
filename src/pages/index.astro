---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Faq from '@/components/Faq.astro';
import Cta from '@/components/Cta.astro';
import Check from '@/components/Check.astro';
import Icon from '@/components/Icon.astro';
import RingMotif from '@/components/RingMotif.astro';
import { services, alwaysIncluded } from '@/data/services';
import { faq } from '@/data/faq';
import { site } from '@/data/site';

/**
 * "Dlaczego my" (USP) i "Jak pracujemy" (4 kroki) przeniesione na /o-nas —
 * strona główna ma być krótsza i skupiona na usługach i konwersji.
 */
---

<BaseLayout
  title="Sprzątanie mieszkań, domów i biur — Poznań | Czyste Sprawy"
  description="Czyste Sprawy — sprzątanie mieszkań, domów i biur, po remoncie, po wynajmie oraz mycie okien w Poznaniu i okolicach. Ubezpieczenie OC, bezpłatna wycena."
  path="/"
>
  <!-- ══ HERO ══ pojedyncza kolumna, cichy pierścień w tle ══ -->
  <section class="relative overflow-hidden border-b border-ivory-line">
    <RingMotif position="right" />
    <div class="relative mx-auto max-w-3xl px-5 pb-16 pt-16 text-center lg:pb-20 lg:pt-24">
      <p class="eyebrow mx-auto">{site.tagline}</p>

      <h1 class="display-xl mt-6 font-display text-forest">
        Czysto tam, gdzie się<br />
        <span class="italic text-forest-soft">mieszka i pracuje</span>
      </h1>

      <p class="mx-auto mt-8 max-w-xl text-lg leading-relaxed text-ink-soft">
        Sprzątamy mieszkania, domy i biura w Poznaniu i okolicach. Cenę podajemy
        przed rozpoczęciem pracy — po bezpłatnej wycenie, bez niespodzianek na miejscu.
      </p>

      <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/wycena" class="btn btn-primary">Bezpłatna wycena</a>
        <a href="/kalkulator" class="btn btn-ghost">Kalkulator orientacyjny</a>
      </div>

      <ul class="mx-auto mt-10 flex flex-wrap justify-center gap-x-7 gap-y-2.5 text-sm text-ink-soft">
        {
          alwaysIncluded.map((i) => (
            <li class="flex items-center gap-2">
              <Check class="!h-4 !w-4" />
              {i}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ══ PASEK ZAUFANIA ══ jasny, zielony tylko w ikonie i tekście ══ -->
  <section class="border-b border-ivory-line bg-ivory-warm">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-10 gap-y-3 px-5 py-4 text-sm text-ink-soft">
      <span class="flex items-center gap-2 font-semibold text-forest">
        <Icon name="insurance" class="h-4 w-4" />
        {site.insurance.label}
      </span>
      <span class="hidden text-ivory-line sm:inline">·</span>
      <span class="font-semibold">{site.areaLabel}</span>
      <span class="hidden text-ivory-line sm:inline">·</span>
      <span class="font-semibold">Dane zweryfikowane w GUS</span>
    </div>
  </section>

  <!-- ══ USŁUGI ══ karty z obwódką ══ -->
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <SectionHeading
        eyebrow="Usługi"
        title="Co dla Ciebie zrobimy"
        lead="Każda usługa ma opisany zakres, żebyś wiedział, za co płacisz."
      />
      <a href="/uslugi" class="text-forest underline underline-offset-4">Wszystkie zakresy →</a>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <a
            href={`/uslugi/${s.slug}`}
            class="group flex flex-col rounded border border-ivory-line bg-white p-7 transition-colors hover:border-forest"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-full bg-sage text-forest">
              <Icon name={s.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-xl text-forest transition-colors group-hover:text-forest-soft">
              {s.name}
            </h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-soft">{s.lead}</p>
            <span class="mt-5 inline-flex items-center gap-2 border-b border-forest/30 pb-0.5 text-sm text-forest transition-colors group-hover:border-forest">
              Zobacz zakres →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ══ OBSZAR ══ -->
  <section class="bg-ivory-warm py-24">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
        <SectionHeading
          eyebrow="Obszar działania"
          title="Poznań i okolice"
          lead="Dojeżdżamy nie tylko po mieście. Przy dalszych lokalizacjach potwierdzamy dojazd przy wycenie."
        />
        <ul class="grid grid-cols-2 gap-x-8 sm:grid-cols-3">
          {
            site.areaServed.map((a) => (
              <li class="rule py-3 text-ink-soft">{a}</li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ══ FAQ ══ -->
  <section class="mx-auto max-w-3xl px-5 py-24">
    <SectionHeading eyebrow="FAQ" title="Częste pytania" align="center" />
    <div class="mt-12"><Faq items={faq.slice(0, 5)} schema /></div>
    <p class="mt-8 text-center">
      <a href="/faq" class="text-forest underline underline-offset-4">
        Zobacz wszystkie pytania
      </a>
    </p>
  </section>

  <div class="py-24"><Cta /></div>
</BaseLayout>
