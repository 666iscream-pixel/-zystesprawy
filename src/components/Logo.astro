---
/**
 * Logotyp: znak (monogram CS w okręgu) + wordmark złożony rozstrzelonymi
 * wersalikami, tak jak w oryginale.
 *
 * Znak pochodzi z pliku klienta — `public/brand/mark.png` to wycięty
 * i przeskalowany fragment logo. ⚠️ Docelowo podmienić na wektor (README).
 */
interface Props {
  variant?: 'full' | 'mark';
  invert?: boolean;
  class?: string;
}
const { variant = 'full', invert = false, class: klass = '' } = Astro.props;
---

<span class={`inline-flex items-center gap-3 ${klass}`}>
  <img
    src="/brand/mark.png"
    alt=""
    width="474"
    height="474"
    decoding="async"
    class="h-11 w-11 shrink-0 rounded-full"
  />
  {
    variant === 'full' && (
      <span class="leading-none">
        <span
          class:list={[
            'block font-sans text-[0.95rem] font-semibold uppercase tracking-[0.2em]',
            invert ? 'text-ivory' : 'text-forest',
          ]}
        >
          Czyste Sprawy
        </span>
        <span
          class:list={[
            'mt-1 block text-[0.62rem] tracking-[0.12em] uppercase',
            invert ? 'text-ivory/60' : 'text-ink-mute',
          ]}
        >
          Sprzątanie · Poznań
        </span>
      </span>
    )
  }
</span>
