---
import Logo from './Logo.astro';
import LangSwitcher from './LangSwitcher.astro';
import { site } from '@/data/site';

/**
 * Bez osobnego zielonego paska kontaktowego — okazał się zbyt ciężki jako
 * pierwsze wrażenie. Obszar i telefon wtopione w główny, jasny wiersz
 * nagłówka, bez koloru tła.
 */
const nav = [
  { href: '/uslugi', label: 'Usługi' },
  { href: '/kalkulator', label: 'Kalkulator' },
  { href: '/dla-firm', label: 'Dla firm' },
  { href: '/galeria', label: 'Galeria' },
  { href: '/blog', label: 'Blog' },
  { href: '/o-nas', label: 'O nas' },
  { href: '/kontakt', label: 'Kontakt' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-ivory-line bg-ivory/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3.5">
    <a href="/" aria-label="Czyste Sprawy — strona główna" class="shrink-0"><Logo /></a>

    <nav aria-label="Główna" class="hidden xl:block">
      <ul class="flex items-center gap-5 text-[0.86rem]">
        {
          nav.map((item) => (
            <li class="whitespace-nowrap">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-forest',
                  isActive(item.href) ? 'font-semibold text-forest' : 'text-ink-soft',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`tel:${site.phone}`}
        class="hidden items-baseline gap-1.5 whitespace-nowrap border-l border-ivory-line pl-3 text-sm text-ink-soft transition-colors hover:text-forest 2xl:flex"
      >
        <span class="text-ink-mute">{site.areaLabel}</span>
        <span class="text-ivory-line">·</span>
        <span class="font-semibold">{site.phoneDisplay}</span>
      </a>

      <a
        href={`tel:${site.phone}`}
        class="flex h-11 w-11 items-center justify-center rounded border border-ivory-line text-forest 2xl:hidden"
        aria-label="Zadzwoń"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M5 4h3l2 5-2.2 1.3a12 12 0 0 0 5.9 5.9L15 14l5 2v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.2 2 2 0 0 1 5 4Z" stroke-linejoin="round"></path>
        </svg>
      </a>

      <LangSwitcher class="hidden xl:block" />

      <a href="/wycena" class="btn btn-primary hidden !px-5 !py-3 text-sm md:inline-flex">
        Bezpłatna wycena
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="-mr-1 rounded p-2 text-forest xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Otwórz menu"
      >
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" aria-label="Mobilna" hidden class="border-t border-ivory-line bg-ivory xl:hidden">
    <ul class="mx-auto max-w-6xl px-5 py-2">
      <li class="border-b border-ivory-line/70 py-3.5 text-sm text-ink-mute">
        {site.areaLabel}
      </li>
      {
        nav.map((item) => (
          <li class="border-b border-ivory-line/70">
            <a
              href={item.href}
              class:list={[
                'block py-3.5 font-medium',
                isActive(item.href) ? 'text-forest' : 'text-ink',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="flex items-center justify-between gap-3 py-4">
        <LangSwitcher />
        <a href="/wycena" class="btn btn-primary w-full !py-3 text-sm md:hidden">Bezpłatna wycena</a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Otwórz menu' : 'Zamknij menu');
    if (menu) menu.hidden = open;
  });
</script>
