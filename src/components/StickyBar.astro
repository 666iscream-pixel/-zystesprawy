---
import { site, waLink, waDefaultMessage } from '@/data/site';
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 gap-px border-t border-ivory-line bg-ivory-line md:hidden">
  <a
    href={`tel:${site.phone}`}
    class="flex flex-col items-center gap-1 bg-ivory py-2.5 text-[0.7rem] font-semibold text-ink"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5 text-forest" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 4h3l2 5-2.2 1.3a12 12 0 0 0 5.9 5.9L15 14l5 2v3a2 2 0 0 1-2.2 2A16 16 0 0 1 3 6.2 2 2 0 0 1 5 4Z" stroke-linejoin="round"></path>
    </svg>
    Zadzwoń
  </a>

  <a
    href={waLink(waDefaultMessage)}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-col items-center gap-1 bg-ivory py-2.5 text-[0.7rem] font-semibold text-ink"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5 text-[#25d366]" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.9 9.9 0 0 0 4.74 1.2c5.46 0 9.9-4.43 9.9-9.9S17.5 2 12.04 2Zm5.8 14.03c-.24.68-1.4 1.3-1.94 1.35-.5.05-1.13.07-1.82-.11a15.6 15.6 0 0 1-1.65-.62c-2.9-1.25-4.8-4.17-4.94-4.37-.15-.2-1.19-1.58-1.19-3.01 0-1.44.75-2.14 1.02-2.44.27-.3.58-.37.78-.37h.56c.18 0 .42-.07.66.5.24.58.82 2.01.9 2.16.07.15.12.32.02.52-.1.2-.15.32-.3.5l-.44.51c-.15.15-.3.31-.13.61.17.3.75 1.23 1.6 2 1.1.98 2.03 1.28 2.33 1.43.3.15.47.12.64-.08.17-.2.74-.86.94-1.16.2-.3.4-.25.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.35.07.12.07.71-.17 1.4Z"></path>
    </svg>
    WhatsApp
  </a>

  <a
    href="/wycena"
    class="flex flex-col items-center gap-1 bg-forest py-2.5 text-[0.7rem] font-semibold text-ivory"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M5 3h14v18l-7-3.5L5 21V3Z" stroke-linejoin="round"></path>
    </svg>
    Wycena
  </a>
</div>
