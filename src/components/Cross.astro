---
/** Czerwony krzyżyk — do list "czego nie robimy". Kontrastuje z zielonymi
 * checkami reszty serwisu, więc wykluczenia są rozpoznawalne na pierwszy rzut oka. */
interface Props { class?: string }
const { class: klass = '' } = Astro.props;
---

<svg
  class={`h-[1.05em] w-[1.05em] shrink-0 text-[#b3402f] ${klass}`}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
>
  <path
    d="M6 6l12 12M18 6L6 18"
    stroke="currentColor"
    stroke-width="2.1"
    stroke-linecap="round"
  ></path>
</svg>
