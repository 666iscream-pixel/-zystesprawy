---
import type { FaqItem } from '@/data/faq';

interface Props {
  items: FaqItem[];
  schema?: boolean;
}
const { items, schema = false } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<div class="divide-y divide-ivory-line border-y border-ivory-line">
  {
    items.map((item, i) => (
      <details class="group" name="faq" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-5 py-5 font-display text-lg text-forest marker:content-none">
          {item.q}
          <span
            class="mt-1 shrink-0 text-sand transition-transform group-open:rotate-45"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </span>
        </summary>
        <div class="pb-6 pr-10 leading-relaxed text-ink-soft">{item.a}</div>
      </details>
    ))
  }
</div>

{schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
