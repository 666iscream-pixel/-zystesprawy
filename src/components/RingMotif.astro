---
/**
 * Duży, cichy pierścień — echo okrągłej ramki wokół monogramu w logo.
 * Dekoracja, nie ilustracja: samo powtórzenie kształtu marki, bardzo
 * przygaszone. Używać oszczędnie — 1–2 razy na cały serwis (sekcje hero),
 * inaczej straci znaczenie.
 */
interface Props {
  position?: 'left' | 'right';
  class?: string;
}
const { position = 'right', class: klass = '' } = Astro.props;

const side = position === 'right' ? '-right-24 sm:-right-40' : '-left-24 sm:-left-40';
---

<svg
  viewBox="0 0 400 400"
  class={`pointer-events-none absolute top-1/2 -z-10 h-[26rem] w-[26rem] -translate-y-1/2 sm:h-[34rem] sm:w-[34rem] ${side} ${klass}`}
  aria-hidden="true"
>
  <circle cx="200" cy="200" r="196" fill="none" stroke="var(--color-forest)" stroke-width="1" opacity="0.08" />
  <circle cx="200" cy="200" r="160" fill="none" stroke="var(--color-forest)" stroke-width="1" opacity="0.06" />
</svg>
